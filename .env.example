APP_NAME="PedeLivre"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="America/Sao_Paulo"
APP_URL=https://pedelivre.com.br

# Previous APP_KEYs (comma separated) for key rotation
APP_PREVIOUS_KEYS=

# HMAC-SHA256 blind index key (>= 32 bytes). Generate with: php -r "echo bin2hex(random_bytes(32));"
BLIND_INDEX_KEY=

# Se true, popula uma loja demonstrativa no db:seed (deixe false em produção)
SEED_DEMO_STORE=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pedelivre_prod
DB_USERNAME=pedelivre_user
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=redis
CARDAPIO_CACHE_STORE=redis
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=pedelivre_

# Configuração de E-mail SMTP (Para recuperação de senha, alertas de queda e envio diário de Backups)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="alertas@pedelivre.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Monitoramento de Queda / Erros Críticos e Recebimento Automático de Backups
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_WHATSAPP=
ADMIN_WHATSAPP_INSTANCE=

# Mercado Pago - merchant OAuth app (non-custodial PIX)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_REDIRECT_URI=https://pedelivre.com.br/api/pagamentos/mercadopago/callback

# Mercado Pago - platform account (SaaS subscriptions)
MP_PLATFORM_ACCESS_TOKEN=
MP_PLATFORM_WEBHOOK_SECRET=

# WhatsApp Evolution API (Multi-tenant QR Code & Live Chat)
EVOLUTION_API_URL=http://127.0.0.1:8085
EVOLUTION_API_KEY=devla_evolution_secret_2026
EVOLUTION_WEBHOOK_SECRET=devla_pedelivre_wpp_secret_2026

# Groq Cloud API (AI Menu Assistant & Whisper Audio Transcription)
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# WhatsApp Meta Cloud API (Official Cloud Webhook - optional)
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_API_VERSION=v20.0
