APP_NAME="PedeLivre"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="America/Sao_Paulo"
APP_URL=https://pedelivre.com.br

# Previous APP_KEYs (comma separated) for key rotation
APP_PREVIOUS_KEYS=

# HMAC-SHA256 blind index key (>= 32 bytes). Generate with: php -r "echo bin2hex(random_bytes(32));"
BLIND_INDEX_KEY=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pedelivre_prod
DB_USERNAME=pedelivre_user
DB_PASSWORD=

BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
CARDAPIO_CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=pedelivre_

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="pedelivre.com.br"
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Mercado Pago - merchant OAuth app (non-custodial PIX)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_REDIRECT_URI=https://pedelivre.com.br/api/pagamentos/mercadopago/callback

# Mercado Pago - platform account (SaaS subscriptions)
MP_PLATFORM_ACCESS_TOKEN=
MP_PLATFORM_WEBHOOK_SECRET=

# WhatsApp Meta Cloud API (bot - premium plan)
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_API_VERSION=v20.0
